# BrandGuard AI Environment Variables
APP_ENV=development
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Keep keys on the backend; without a key, text audits use rule-based checks
# and visual reviews are unavailable.
GEMINI_API_KEY=

# Per-client limits for Gemini-backed requests.
GEMINI_ANALYSIS_RATE_LIMIT=10 per minute
GEMINI_REWRITE_RATE_LIMIT=5 per minute

# Local development only. Production should use a shared Redis-compatible URI.
RATELIMIT_STORAGE_URI=memory://
